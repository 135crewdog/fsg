# Pinned versions for the JSBSim baseline. Sourced by the scripts in scripts/.
# Reasons are in REPORT.md ("Pins").
JSBSIM_REPO=https://github.com/JSBSim-Team/jsbsim.git
JSBSIM_TAG=v1.3.3
JSBSIM_COMMIT=66f7fafc07fe13e7ede9db20873030fed2881713
EMSDK_REPO=https://github.com/emscripten-core/emsdk.git
EMSDK_VERSION=6.0.13
# Commit time of the JSBSim pin (2026-10-16 00:57:05 +0200); makes __DATE__/__TIME__ repeatable.
SOURCE_DATE_EPOCH=1792105025
# Fixed WebAssembly memory (no growth) and stack, in MiB. 16 MiB: measured heap peak over all 61 aircraft is
# 3.34 MiB (results/load-test.txt); the test runner's longest trace needs about 7 MiB more.
WASM_MEMORY_MB=16
WASM_STACK_MB=1
# Upstream git tree ids of the data folders at the pin (checked by scripts/check-data.sh).
TREE_aircraft=962d46764e278f7f1907b6ca86d3af0585d69a76
TREE_engine=209e17a602c99cd8a021d1c41515622f463bee68
TREE_systems=a87444bcb6776b6c59c27fc2de3094e8dcd2d353
TREE_scripts=14394154199758f25132437c04192a5b3b9b9fcf
TREE_check_cases_NASA_EOM_2015=224e8cfbdbb2522346666a587fa2632dc245c477
BLOB_COPYING=3394995abc5463238286bc53ce7608839b5d0ba7
