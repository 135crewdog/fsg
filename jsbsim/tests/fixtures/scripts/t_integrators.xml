<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test fixture: changes integrator settings twice.
  At load: rate/rotational is set to 4 through a script property.
  At 0.1 s: position/rotational is set to 2 by an event.
-->
<runscript name="integrator script">
  <use aircraft="c172x" initialize="reset01"/>
  <run start="0.0" end="10" dt="0.008333333333333333">
    <property value="4"> simulation/integrator/rate/rotational </property>
    <event name="change integrator">
      <condition> simulation/sim-time-sec ge 0.1 </condition>
      <set name="simulation/integrator/position/rotational" value="2"/>
    </event>
  </run>
</runscript>
