 <!--
  Two General Electric J79-GE-15 engines (Engines/J79-GE-15.xml), left then right.

  Where each one's thrust acts. Fore and aft and sideways it is the model's engine exit (Wings, nozzles_ft:
  16.16 ft behind the centre of gravity, 2.17 ft out). In direction and height it is CR-2144's thrust line
  (table IV-2): tilted 5.25 degrees, so the exhaust goes down and aft and the thrust has a small upward
  part; and passing 0.37 ft above the centre of gravity, so power pushes the nose down a little.
  A line through a point 16.16 ft behind and h ft above the centre of gravity, rising forward at 5.25
  degrees, passes above the centre of gravity by 16.16 sin 5.25 + h cos 5.25. For that to be 0.37 ft,
  h = (0.37 - 1.4787) / 0.9958 = -1.1133 ft: the thrust point is 13.36 in below the centre of gravity.
  (The model's exits are 0.61 ft below it; the half foot between is CR-2144's line against the model's shape.)
  tests/f4c.test.js proves it from a run: at MIL, standing still, the engines' pitching moment is nose down
  and is the thrust times 0.37 ft.

  JSBSim's pitch of a thruster is positive nose up: the thrust then points forward and up.

  One tank at the centre of gravity holds the fuel that makes up CR-2144's weight: 8,924 lb. The game
  freezes it (propulsion/fuel_freeze), so the weight never changes. A test can set another amount.
  Its capacity, 13,000 lb, is about the F-4C's internal fuel (from memory: 1,972 US gallons of JP-4; not
  checked, and nothing depends on it).
 -->
 <propulsion>
  <engine file="J79-GE-15">
   <feed> 0 </feed>
   <thruster file="direct">
    <location unit="IN">
     <x> 193.92 </x>
     <y> -26.04 </y>
     <z> -13.36 </z>
    </location>
    <orient unit="DEG">
     <roll> 0 </roll>
     <pitch> 5.25 </pitch>
     <yaw> 0 </yaw>
    </orient>
   </thruster>
  </engine>
  <engine file="J79-GE-15">
   <feed> 0 </feed>
   <thruster file="direct">
    <location unit="IN">
     <x> 193.92 </x>
     <y> 26.04 </y>
     <z> -13.36 </z>
    </location>
    <orient unit="DEG">
     <roll> 0 </roll>
     <pitch> 5.25 </pitch>
     <yaw> 0 </yaw>
    </orient>
   </thruster>
  </engine>
  <tank type="FUEL">
   <location unit="IN">
    <x> 0 </x>
    <y> 0 </y>
    <z> 0 </z>
   </location>
   <capacity unit="LBS"> 13000 </capacity>
   <contents unit="LBS"> 8924 </contents>
  </tank>
 </propulsion>

 <!--
  The airplane's own systems (its FCS, in the owner's words): what the real jet does between the cockpit
  and the airplane. So far the throttles and the gear; the feel system, the stability augmentation and the
  flight controls come in pull request 6.
 -->
 <flight_control name="F-4C">

  <!--
   Where MIL is on the throttle: the game's throttle runs 0 to 1, and this much of it is idle to MIL.
   The rest is the afterburner. The game's settings (src/sim/aircraft/f4c.js, `mil`) say the same number,
   and a test holds the two together.
  -->
  <property value="0.8"> fcs/mil-throttle-norm </property>

  <!--
   The throttles, one channel for each engine. In: fcs/throttle-cmd-norm, 0 to 1. Out, to the engine:
   fcs/throttle-pos-norm, which JSBSim's turbine reads as 0 to 1 idle to MIL and 1 to 2 the afterburner
   (its "augmethod 2"; JSBSim's own f16.xml writes it from a channel the same way).

     dry part            the throttle up to MIL, as 0 to 1
     afterburner asked   the throttle beyond MIL, as 0 to 1
     afterburner given   what is asked, but only while the engine turns at 97% or more

   The last line is the real engine's: its afterburner lights only at MIL speed. JSBSim v1.3.3's turbine
   (src/models/propulsion/FGTurbine.cpp, Run) would give afterburner thrust the instant it is asked,
   whatever the engine's speed, so the wait is here. 97% is JSBSim's own figure for its other afterburner
   method (the same file: "N2 > 97.0"); the J79's own light-off speed is not in the sources read. Reasoned.
   fcs/afterburner-norm, 0 to 1, is the afterburner given: what the plumes will read.
  -->
  <channel name="Left throttle">
   <fcs_function name="fcs/throttle-dry-norm">
    <function>
     <quotient>
      <property> fcs/throttle-cmd-norm </property>
      <property> fcs/mil-throttle-norm </property>
     </quotient>
    </function>
    <clipto>
     <min> 0 </min>
     <max> 1 </max>
    </clipto>
   </fcs_function>
   <fcs_function name="fcs/afterburner-asked-norm">
    <function>
     <quotient>
      <difference>
       <property> fcs/throttle-cmd-norm </property>
       <property> fcs/mil-throttle-norm </property>
      </difference>
      <difference>
       <value> 1 </value>
       <property> fcs/mil-throttle-norm </property>
      </difference>
     </quotient>
    </function>
    <clipto>
     <min> 0 </min>
     <max> 1 </max>
    </clipto>
   </fcs_function>
   <switch name="fcs/afterburner-norm">
    <default value="0"/>
    <test value="fcs/afterburner-asked-norm">
     propulsion/engine[0]/n2 ge 97
    </test>
   </switch>
   <summer name="fcs/throttle-to-engine">
    <input> fcs/throttle-dry-norm </input>
    <input> fcs/afterburner-norm </input>
    <output> fcs/throttle-pos-norm </output>
   </summer>
  </channel>

  <channel name="Right throttle">
   <fcs_function name="fcs/throttle-dry-norm[1]">
    <function>
     <quotient>
      <property> fcs/throttle-cmd-norm[1] </property>
      <property> fcs/mil-throttle-norm </property>
     </quotient>
    </function>
    <clipto>
     <min> 0 </min>
     <max> 1 </max>
    </clipto>
   </fcs_function>
   <fcs_function name="fcs/afterburner-asked-norm[1]">
    <function>
     <quotient>
      <difference>
       <property> fcs/throttle-cmd-norm[1] </property>
       <property> fcs/mil-throttle-norm </property>
      </difference>
      <difference>
       <value> 1 </value>
       <property> fcs/mil-throttle-norm </property>
      </difference>
     </quotient>
    </function>
    <clipto>
     <min> 0 </min>
     <max> 1 </max>
    </clipto>
   </fcs_function>
   <switch name="fcs/afterburner-norm[1]">
    <default value="0"/>
    <test value="fcs/afterburner-asked-norm[1]">
     propulsion/engine[1]/n2 ge 97
    </test>
   </switch>
   <summer name="fcs/throttle-to-engine[1]">
    <input> fcs/throttle-dry-norm[1] </input>
    <input> fcs/afterburner-norm[1] </input>
    <output> fcs/throttle-pos-norm[1] </output>
   </summer>
  </channel>

  <!--
   The landing gear: up or down in 4 seconds. Wings' time; the flight manual gives none. The way of
   writing it is JSBSim's own f16.xml's.
  -->
  <channel name="Landing gear">
   <kinematic name="fcs/gear-control">
    <input> gear/gear-cmd-norm </input>
    <traverse>
     <setting>
      <position> 0 </position>
      <time> 0 </time>
     </setting>
     <setting>
      <position> 1 </position>
      <time> 4 </time>
     </setting>
    </traverse>
    <output> gear/gear-pos-norm </output>
   </kinematic>
  </channel>

 </flight_control>

