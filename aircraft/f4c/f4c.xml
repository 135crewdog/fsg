  <author> FSG (135crewdog/fsg), written by Claude Code </author>
  <filecreationdate> 2026-11-26 </filecreationdate>
  <version> milestone 3, pull request 3 </version>
  <description> McDonnell F-4C Phantom II: mass, gear and engines. No aerodynamics yet. </description>
  <reference refID="NASA CR-2144" author="R. K. Heffley and W. F. Jewell" title="Aircraft Handling Qualities Data" date="1972"/>
  <reference refID="T.O. 1F-4C-1" author="USAF" title="Flight Manual, F-4C, F-4D and F-4E" date="1970-10-01"/>
 </fileheader>

