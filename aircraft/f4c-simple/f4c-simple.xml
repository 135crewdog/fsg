<?xml version="1.0"?>
<!--
  The simple F-4C Phantom II, for JSBSim v1.3.3: the airplane of the game. FSG's own aircraft file: new in
  FSG, milestone 3 re-planned (docs/milestones/3-replan.md, pull request 3).

  What it is. A file of numbers on the shared simple physics (aircraft/simple/aero.xml, which says what
  each number means and where each rule came from) and the shared control run
  (aircraft/simple/controls.xml). The owner (28 November 2026): "Simple but honest physics. Simple but not
  nit-picky aircraft." Here are its size, its mass, its wheels, its engines and its own systems (throttles
  and afterburners, flaps, speedbrakes, gear); the block "The numbers" is everything about how it flies.

  Where each number comes from. Every number below names one of these.
    Wings     135crewdog/wings, src/sim/cards/f4c.js and src/sim/card.js, commit 6d689b7: the F-4C card
              the owner flew and liked, and what its card.js works out from it.
    T.O.      T.O. 1F-4C-1, the F-4C flight manual (1 October 1970).
    data-built  the data-built F-4C, aircraft/f4c/f4c.xml (NASA CR-2144 and the rest), kept beside this
              one: its weight, inertias, wheels, contact points and its engines' and systems' logic are
              borrowed as they are, each with the comments it has there.
    set so that ...  a number chosen so that a line of the plan is met; the test named flies it
              (tests/simple-f4c.test.js). These are Claude Code's engineering choices.

  Axes. JSBSim's structural frame, in inches: x aft, y to the right, z up. Its origin is the centre of
  gravity as loaded, which is the origin of the owner's model (models/f4c.glb).
-->
<fdm_config name="F-4C Phantom II (simple)" version="2.0" release="ALPHA"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:noNamespaceSchemaLocation="http://jsbsim.sourceforge.net/JSBSim.xsd">

 <fileheader>
  <author> FSG (135crewdog/fsg), written by Claude Code </author>
  <filecreationdate> 2026-11-28 </filecreationdate>
  <version> milestone 3 re-planned, pull request 3 </version>
  <description> McDonnell F-4C Phantom II on FSG's simple physics: a file of numbers. </description>
 </fileheader>

 <!--
  The wing: 530 sq ft, 38.67 ft across, a mean chord of 16.04 ft (the data-built file's: NASA CR-2144,
  table IV-2; Wings' card has 530 and 38.4). The air's forces act at the centre of gravity: the simple
  physics gives its turning moments directly, so nothing here has a lever arm.
 -->
 <metrics>
  <wingarea unit="FT2"> 530 </wingarea>
  <wingspan unit="FT"> 38.67 </wingspan>
  <chord unit="FT"> 16.04 </chord>
  <location name="AERORP" unit="IN">
   <x> 0 </x>
   <y> 0 </y>
   <z> 0 </z>
  </location>
  <location name="VRP" unit="IN">
   <x> 0 </x>
   <y> 0 </y>
   <z> 0 </z>
  </location>
 </metrics>

 <!--
  38,924 lb, and its inertias: the data-built file's (NASA CR-2144, table IV-2), so the two F-4Cs compare
  like for like (the plan's default; Wings' card flies at 38,000). The weight is 30,000 lb here and 8,924 lb
  in the one tank, as there; the game freezes the fuel. The cross inertia is written the usual way round
  (see the data-built file for JSBSim's sign).
 -->
 <mass_balance negated_crossproduct_inertia="false">
  <ixx unit="SLUG*FT2"> 25002 </ixx>
  <iyy unit="SLUG*FT2"> 122193 </iyy>
  <izz unit="SLUG*FT2"> 139767 </izz>
  <ixz unit="SLUG*FT2"> 2177 </ixz>
  <emptywt unit="LBS"> 30000 </emptywt>
  <location name="CG" unit="IN">
   <x> 0 </x>
   <y> 0 </y>
   <z> 0 </z>
  </location>
 </mass_balance>

