 <!--
  THE NUMBERS: how it flies. aircraft/simple/aero.xml says what each one does.
 -->
 <system name="numbers">
  <!-- == Lift == -->
  <!-- Stall speed clean, knots: Wings' card (stall_clean_kt). The data-built jet's is 140. -->
  <property value="145"> simple/stall-clean-kt </property>
  <!-- Stall speed with gear and full flaps, knots: Wings' card (stall_landing_kt); T.O., figure 6-1: 122 to 126 at 38,000 lb. -->
  <property value="125"> simple/stall-landing-kt </property>
  <!--
   Lift for each radian of angle of attack: Wings (card.js, liftSlope: a wing of aspect ratio 2.78 swept 45
   degrees, at low speed). With the stall speed it puts the stall at 21.7 degrees of angle of attack; the
   data-built jet's nose slice begins at 22.
  -->
  <property value="2.726"> simple/lift-slope </property>
  <!-- The lift falls away over 6 degrees past the stall angle: Wings' card (stall_sharpness 0.5, the middle of 10 to 2). -->
  <property value="6"> simple/stall-width-deg </property>
  <!-- Fully stalled it still makes a flat plate's lift: Wings (card.js, plateLift). The F-4's stall is a nose-high mush, not a break. -->
  <property value="0.85"> simple/mush-lift </property>

  <!-- == Drag == -->
  <!-- Its own drag, below the drag rise: Wings (card.js, SUBSONIC_CD0: "a clean jet fighter's own drag"). -->
  <property value="0.022"> simple/drag-clean </property>
  <!--
   Its own drag above the drag rise. Set so that both top speeds come out in full afterburner: 766 knots at
   sea level (the flight manual's limit is 750; the data-built jet 754) and Mach 2.24 at 40,000 ft (Wings'
   card: 2.2): tests/simple-f4c.test.js, the top speed line. Wings works its own out from its two top speeds.
  -->
  <property value="0.047"> simple/drag-supersonic </property>
  <!--
   The drag that comes with lift, below the drag rise. Set so that energy matters (tests/simple-f4c.test.js):
   a full-back turn through 180 degrees from 450 knots in full afterburner comes out about 105 knots slower
   (the hard turn line); a 4 g tilt held from 450 knots loops it, over the top near 300 knots, and no held
   tilt loops it from 250 in MIL (the loop line); and it sustains about 6.1 g at 450 knots low down
   (reported). Between Wings' own, 0.153 from the wing's shape (it would sustain 6.9 g there), and what
   NASA CR-2144's lift and drag imply with this thrust, about 0.33 (4.8 g; the data-built jet holds 4.2,
   which the findings call too much drag). The first number to move if a turn costs too little or too much.
  -->
  <property value="0.2"> simple/drag-in-a-pull </property>
  <!-- Above the drag rise: Wings' rule there is 1 over the lift slope, 0.32 at Mach 1.2 rising to 0.43 at Mach 2; one figure between. -->
  <property value="0.35"> simple/drag-in-a-pull-supersonic </property>
  <!-- The gear, full flaps and the open speedbrakes: Wings' card (gear_drag, flap_drag and speedbrake_drag, each 0.5: the middle of its range). -->
  <property value="0.025"> simple/drag-gear </property>
  <property value="0.05"> simple/drag-flaps </property>
  <property value="0.06"> simple/drag-boards </property>
  <!--
   The open speedbrakes push the nose down a little: Wings (card.js, speedbrake: their drag acting halfway
   between the centre of gravity and the panels, 1.245 ft below it, the owner's choice of 17 November 2026):
   0.06 x 1.245 ft over the 16.04 ft chord.
  -->
  <property value="-0.0047"> simple/boards-pitch </property>

  <!-- == Pitch == -->
  <!-- Phone level holds 350 knots, clean: Wings' card (neutral_speed_kt), the owner's figure. -->
  <property value="350"> simple/trim-speed-kt </property>
  <!-- Full back tilt above corner speed (423 knots: 145 times the square root of 8.5): Wings' card (g_limit); T.O., figure 5-1: 8.5 g. -->
  <property value="8.5"> simple/g-limit </property>
  <!-- Full forward tilt when fast: Wings (card.js, gDown: 0.35 of the g limit). -->
  <property value="3"> simple/g-limit-push </property>
  <!-- Full back tilt when slow holds 1.2 times the stall angle, so the wing stalls when asked: Wings (aero.js, elevatorPower). -->
  <property value="1.2"> simple/full-back-over-stall </property>
  <!--
   The tail's power, stabilator at full travel nose up. Set so that full back tilt lifts the nosewheel at the
   owner's 150 knots on 1/2 flaps in full afterburner (148 knots: tests/simple-f4c.test.js, the rotation
   line). The same number makes the nose's stiffness (aircraft/simple/aero.xml), about twice Wings': one
   plain set of numbers does both jobs, so Wings' extra bite on the runway is not needed (the plan's first
   risk). A rough sum agrees: at 150 knots the main wheels, 3.52 ft behind the centre of gravity, still
   carry 31,700 lb, which takes a moment of 0.18 of the wing's; the tail gives 0.153 and the nose's own
   pull up toward its trim angle the rest.
  -->
  <property value="0.153"> simple/tail-power </property>
  <!-- The stabilator's travel, 21 degrees trailing edge up and 9 down: the real jet's and the model's (docs/models.md; the data-built file). -->
  <property value="21"> simple/elevator-up-deg </property>
  <property value="9"> simple/elevator-down-deg </property>
  <!--
   Pitch damping: on the pitch rate, and on the angle of attack changing. Set so that the nose settles after
   a step of the stick with no overshoot low down and under 10% at 40,000 ft
   (tests/simple-f4c-reported.test.js prints it). Wings has -2 and -8; on this stiffer nose those overshoot
   9% at 2,000 ft and up to 46% at 40,000 ft, and the findings' pilot model bounced on 30%.
  -->
  <property value="-6"> simple/pitch-damping </property>
  <property value="-16"> simple/pitch-damping-alpha </property>

  <!-- == Roll == -->
  <!-- Full tilt rolls it 180 degrees a second at 400 knots: Wings' card (roll_rate_dps at roll_rate_at_kt). -->
  <property value="180"> simple/roll-rate-dps </property>
  <property value="400"> simple/roll-rate-at-kt </property>
  <!-- Each aileron's travel: the real jet's 30 degrees (the data-built file). -->
  <property value="30"> simple/aileron-deg </property>
  <!-- The wing's roll damping: what Wings' two-half wing gives (card.js: "about -0.29 here, typical of a fighter"). -->
  <property value="-0.29"> simple/roll-damping </property>
  <!--
   A stalled wing keeps a quarter of its ailerons' power. Set so that a sloppy stall can drop a wing, and
   letting go recovers it (tests/simple-f4c.test.js, the sloppy stall line): full back and full right tilt
   held 5 s in the stall bank it about 55 degrees; let go, it is flying again in half a second, upright. At
   a half, the same 5 s put it past 90 degrees and it came out in a dive that took 13 s to come upright.
  -->
  <property value="0.25"> simple/stalled-aileron </property>
  <!-- A sideslip rolls it away from the slip: Wings (card.js, Clb). -->
  <property value="-0.08"> simple/dihedral </property>

  <!-- == Yaw == -->
  <!-- The fin's and body's sideways push, the fin's swing into a sideslip, and its damping: Wings (card.js: CYb, Cnb, Cnr). -->
  <property value="-0.7"> simple/side-force </property>
  <property value="0.12"> simple/yaw-stiffness </property>
  <property value="-0.3"> simple/yaw-damping </property>
  <!-- Full rudder holds about 6 degrees of sideslip: Wings (card.js, rudder.cn: 0.12 x 6 degrees). The rudder's travel is the real jet's 30 degrees. -->
  <property value="0.0126"> simple/rudder-power </property>
  <property value="30"> simple/rudder-deg </property>
  <!-- Full aileron swings the nose the wrong way a little: Wings (card.js, adverseYaw: 0.07 of the aileron's roll power). -->
  <property value="0.002"> simple/adverse-yaw </property>
 </system>

 <!--
  The airplane's own systems: the data-built file's, element for element (tests/simple-f4c.test.js holds
  them identical): the throttles, with MIL at 0.8 of the game's throttle and an afterburner that lights
  only once the engine turns at 97% or more (fcs/afterburner-norm is what the plumes read); the flaps, 8 s
  down and 6 s up (the flight manual); the speedbrakes, 1.5 s (Wings); the gear, 4 s (Wings). The
  data-built file has the reasons at each.
 -->
 <flight_control name="F-4C systems">

  <property value="0.8"> fcs/mil-throttle-norm </property>

  <channel name="Left throttle">
   <fcs_function name="fcs/throttle-dry-norm">
    <function>
     <quotient>
      <property> fcs/throttle-cmd-norm </property>
      <property> fcs/mil-throttle-norm </property>
     </quotient>
    </function>
    <clipto>
     <min> 0 </min>
     <max> 1 </max>
    </clipto>
   </fcs_function>
   <fcs_function name="fcs/afterburner-asked-norm">
    <function>
     <quotient>
      <difference>
       <property> fcs/throttle-cmd-norm </property>
       <property> fcs/mil-throttle-norm </property>
      </difference>
      <difference>
       <value> 1 </value>
       <property> fcs/mil-throttle-norm </property>
      </difference>
     </quotient>
    </function>
    <clipto>
     <min> 0 </min>
     <max> 1 </max>
    </clipto>
   </fcs_function>
   <switch name="fcs/afterburner-norm">
    <default value="0"/>
    <test value="fcs/afterburner-asked-norm">
     propulsion/engine[0]/n2 ge 97
    </test>
   </switch>
   <summer name="fcs/throttle-to-engine">
    <input> fcs/throttle-dry-norm </input>
    <input> fcs/afterburner-norm </input>
    <output> fcs/throttle-pos-norm </output>
   </summer>
  </channel>

  <channel name="Right throttle">
   <fcs_function name="fcs/throttle-dry-norm[1]">
    <function>
     <quotient>
      <property> fcs/throttle-cmd-norm[1] </property>
      <property> fcs/mil-throttle-norm </property>
     </quotient>
    </function>
    <clipto>
     <min> 0 </min>
     <max> 1 </max>
    </clipto>
   </fcs_function>
   <fcs_function name="fcs/afterburner-asked-norm[1]">
    <function>
     <quotient>
      <difference>
       <property> fcs/throttle-cmd-norm[1] </property>
       <property> fcs/mil-throttle-norm </property>
      </difference>
      <difference>
       <value> 1 </value>
       <property> fcs/mil-throttle-norm </property>
      </difference>
     </quotient>
    </function>
    <clipto>
     <min> 0 </min>
     <max> 1 </max>
    </clipto>
   </fcs_function>
   <switch name="fcs/afterburner-norm[1]">
    <default value="0"/>
    <test value="fcs/afterburner-asked-norm[1]">
     propulsion/engine[1]/n2 ge 97
    </test>
   </switch>
   <summer name="fcs/throttle-to-engine[1]">
    <input> fcs/throttle-dry-norm[1] </input>
    <input> fcs/afterburner-norm[1] </input>
    <output> fcs/throttle-pos-norm[1] </output>
   </summer>
  </channel>

  <channel name="Flaps">
   <actuator name="fcs/flap-actuator">
    <input> fcs/flap-cmd-norm </input>
    <rate_limit sense="incr"> 0.125 </rate_limit>
    <rate_limit sense="decr"> 0.16666666666666666 </rate_limit>
    <clipto>
     <min> 0 </min>
     <max> 1 </max>
    </clipto>
    <output> fcs/flap-pos-norm </output>
   </actuator>
  </channel>

  <channel name="Speedbrakes">
   <actuator name="fcs/speedbrake-actuator">
    <input> fcs/speedbrake-cmd-norm </input>
    <rate_limit> 0.6666666666666666 </rate_limit>
    <clipto>
     <min> 0 </min>
     <max> 1 </max>
    </clipto>
    <output> fcs/speedbrake-pos-norm </output>
   </actuator>
  </channel>

  <channel name="Landing gear">
   <kinematic name="fcs/gear-control">
    <input> gear/gear-cmd-norm </input>
    <traverse>
     <setting>
      <position> 0 </position>
      <time> 0 </time>
     </setting>
     <setting>
      <position> 1 </position>
      <time> 4 </time>
     </setting>
    </traverse>
    <output> gear/gear-pos-norm </output>
   </kinematic>
  </channel>

 </flight_control>

 <!-- The shared control run: stick to stabilator, ailerons and rudder, through one curve against speed. -->
 <system file="../simple/controls"/>

 <!-- The shared simple physics. -->
 <aerodynamics file="../simple/aero.xml"/>

</fdm_config>
